# SaralDocs Frontend Environment Variables
# Copy to .env or .env.local to configure local settings.
# NOTE: The frontend communicates ONLY with the backend API. Never place AI secret API keys in the frontend!

# Backend API Base URL (defaults to http://localhost:4000/api)
VITE_API_BASE_URL=http://localhost:4000/api

# Master feature flag for AI assistant capabilities (true/false)
# When set to false, UI shows a friendly "AI assistant is not configured yet" message.
VITE_AI_ENABLED=true

# Mock mode flag (true/false)
# When true, the AI client uses a local mock adapter with realistic responses,
# allowing UI testing without a live AI backend or API keys.
VITE_AI_MOCK_MODE=true
