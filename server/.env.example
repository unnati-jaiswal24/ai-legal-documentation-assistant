# Copy this file to server/.env. Replace all placeholder values locally.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://saraldocs:saraldocs@localhost:5432/saraldocs
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
BCRYPT_ROUNDS=12
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=SaralDocs Admin
PRIVATE_UPLOAD_DIR=./storage/private
MAX_UPLOAD_BYTES=5242880

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_GENERIC_EXPLANATIONS_ENABLED=false
GEMINI_DOCUMENT_REVIEW_ENABLED=false
GEMINI_REPORT_GENERATION_ENABLED=false
GEMINI_REPORT_MODEL=gemini-2.5-flash
ENABLE_DEV_AI_ROUTE=false
